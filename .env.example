# Copia este fichero como `.env.local` y ajusta los valores.
# `.env.local` está en .gitignore y no se sube al repositorio.

# Endpoint del formulario de contacto (Formspree u otro servicio compatible).
# Si no se define, se usa el valor de src/data/portfolio.js.
VITE_FORM_ENDPOINT=https://formspree.io/f/tu-id
